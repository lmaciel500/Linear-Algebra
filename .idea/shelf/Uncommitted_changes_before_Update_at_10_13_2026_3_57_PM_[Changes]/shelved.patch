 i = 0; i < n; i++) {\r\n\t\t\tcoefficients[i] = (*A).matrix[0][i];\r\n\t\t}\r\n\t\tfor (int excluded = 0; excluded < n; excluded++) {\r\n\t\t\tMatrix B = {0};\r\n\t\t\tB.rows = m - 1;\r\n\t\t\tB.columns = n - 1;\r\n\r\n\t\t\tint o = B.rows;\r\n\t\t\tint p = B.columns;\r\n\t\t\tfor (int i = 0; i < o; i++) {\r\n\t\t\t\tfor (int j = 0; j < p; j++) {\r\n\t\t\t\t\tint shift = 0;\r\n\t\t\t\t\tif (!(j < excluded)) {\r\n\t\t\t\t\t\tshift++;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tB.matrix[i][j] = (*A).matrix[i + 1][j + shift];\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif (excluded % 2 == 0) {\r\n\t\t\t\tdeterminant += coefficients[excluded] * Det(&B);\r\n\t\t\t} else {\r\n\t\t\t\tdeterminant -= coefficients[excluded] * Det(&B);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n    return determinant;\r\n}\r\nint Rank(Matrix *A) {\r\n    int rank = 0;\r\n    int m = (*A).rows;\r\n    int n = (*A).columns;\r\n    for (int i = 0; i < m; i++) {\r\n        for (int j = 0; j < n; j++) {\r\n            if ((*A).matrix[i][j] == 1) {\r\n                for (int k = 0; k < m; k++) {\r\n                    if (k == i) {\r\n                        continue;\r\n                    }\r\n                    if ((*A).matrix[k][j] != 0) {\r\n                        break;\r\n                    }\r\n                    if (k == m - 1) {\r\n                        rank++;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    }\r\n    return rank;\r\n}\r\n\r\n\r\n//arithmetic\r\nvoid MultMatrix(Matrix *A, Matrix *B, Matrix *C) {\r\n    int m = (*A).rows;\r\n    int n = (*A).columns;\r\n    double (*matrix1)[100] = (*A).matrix;\r\n\r\n    int o = (*B).rows;\r\n    int p = (*B).columns;\r\n    double (*matrix2)[100] = (*B).matrix;\r\n\r\n    double (*result)[100] = (*C).matrix;\r\n    for (int i = 0; i < m; i++) {\r\n        for (int j = 0; j < p; j++) {\r\n            for (int k = 0; k < n; k++) {\r\n                result[i][j] += matrix1[i][k] * matrix2[k][j];\r\n            }\r\n        }\r\n    }\r\n    //PrintMatrix();\r\n    printf(\"\\n\");\r\n}\r\n/*\r\nvoid AddMatrix(int n, double matrix1[n][n], double matrix2[n][n], double result[n][n]) {\r\n    PrintMatrix(n, matrix1);\r\n    printf(\"+\\n\");\r\n    PrintMatrix(n, matrix2);\r\n    printf(\"=\\n\");\r\n\r\n    for (int i = 0; i < n; i++) {\r\n        for (int j = 0; j < n; j++) {\r\n            result[i][j] = matrix1[i][j] + matrix2[i][j];\r\n        }\r\n    }\r\n\r\n    PrintMatrix(n, result);\r\n    printf(\"\\n\");\r\n}\r\n*/\r\n\r\n\r\n//logic\r\nvoid StoreMatrix(Matrix *A) {\r\n    char decision;\r\n    printf(\"Store this matrix? (y/n): \");\r\n    scanf(\" %c\", &decision);\r\n    if (decision == 'y') {\r\n        AddMatrix(*A);\r\n    }\r\n}\r\nbool Confirm() {\r\n    bool confirm;\r\n    printf(\"Are you sure? (y/n): \" );\r\n    char decision;\r\n    scanf(\" %c\", &decision);\r\n    if (decision == 'y') {\r\n        confirm = true;\r\n    } else {\r\n        confirm = false;\r\n    }\r\n    printf(\"\\n\");\r\n    return confirm;\r\n}\r\nvoid ResetState() {\r\n    STATE.AUGMENT = false;\r\n    STATE.LU = false;\r\n    STATE.INVERSE = false;\r\n    STATE.MULT = false;\r\n    STATE.REF = false;\r\n    STATE.RREF = false;\r\n}\r\nchar SelectMenu() {\r\n    char decision;\r\n    scanf(\" %c\", &decision);\r\n    printf(\"\\n\");\r\n    return decision;\r\n}\r\n\r\n\r\nvoid StartSettings() {\r\n    PrintLine();\r\n    PrintSettings();\r\n    switch (SelectMenu()) {\r\n        case 's':\r\n            STATE.SHOW_STEPS = !STATE.SHOW_STEPS;\r\n            printf(\"Show Steps set to %s.\\n\\n\", STATE.SHOW_STEPS ? \"true\" : \"false\");\r\n            break;\r\n        default:\r\n            break;\r\n    }\r\n}\r\nchar StartSelector() {\r\n    PrintLine();\r\n    PrintCollection();\r\n    if (GLOBAL.amount > 0) {\r\n        printf(\"Select matrix: \");\r\n        char decision = SelectMenu();\r\n        if (CheckExists(decision)) {\r\n            Matrix A = GLOBAL.matrices[ToIndex(decision)];\r\n   