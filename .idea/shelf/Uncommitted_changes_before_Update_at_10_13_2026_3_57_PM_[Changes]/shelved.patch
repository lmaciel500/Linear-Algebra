   int occupied;\r\n        fscanf(inFile, \"%d \", &occupied);\r\n        if (occupied) {\r\n            A.occupied = true;\r\n        } else {\r\n            A.occupied = false;\r\n        }\r\n        char type;\r\n        fscanf(inFile, \"%c \", &type);\r\n        switch (type) {\r\n            case 'r':\r\n                A.type = REDUCED;\r\n                break;\r\n            case 'a':\r\n                A.type = AUGMENTED;\r\n                break;\r\n            case 'i':\r\n                A.type = INVERSE;\r\n                break;\r\n            case 'u':\r\n                A.type = LU;\r\n                break;\r\n            default:\r\n                A.type = STANDARD;\r\n                break;\r\n        }\r\n        int rows, columns;\r\n        fscanf(inFile, \"%d \", &rows);\r\n        fscanf(inFile, \"%d \", &columns);\r\n\r\n        A.rows = rows;\r\n        A.columns = columns;\r\n\r\n        for (int i = 0; i < rows; i++) {\r\n            for (int j = 0; j < columns; j++) {\r\n                double temp;\r\n                fscanf(inFile, \"%lf \", &temp);\r\n                A.matrix[i][j] = temp;\r\n            }\r\n        }\r\n        GLOBAL.matrices[k] = A;\r\n        fscanf(inFile, \"\\n\");\r\n    }\r\n    fclose(inFile);\r\n}\r\nvoid WriteData() {\r\n    printf(\"\\n\");\r\n    printf(\"Writing data to disk...\\n\");\r\n    Sleep(1000);\r\n    FILE* inFile = fopen(\"data.txt\", \"w\");\r\n    if (inFile == NULL) {\r\n        printf(\"Error writing data to disk.\\n\");\r\n        return;\r\n    }\r\n    fprintf(inFile, \"%d \", GLOBAL.amount);\r\n    fprintf(inFile, \"%d\\n\", STATE.SHOW_STEPS);\r\n    for (int k = 0; k < GLOBAL.amount; k++) {\r\n        if (GLOBAL.matrices[k].occupied) {\r\n            fprintf(inFile, \"%d \", 1);\r\n        } else {\r\n            fprintf(inFile, \"%d \", 0);\r\n        }\r\n        switch (GLOBAL.matrices[k].type) {\r\n            case REDUCED:\r\n                fprintf(inFile, \"%c \", 'r');\r\n 